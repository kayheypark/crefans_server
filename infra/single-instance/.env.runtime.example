# Copy to .env.runtime outside version control. Default preserves AWS auth.
AUTH_PROVIDER=cognito
# During migration/local mode only:
MEMBER_MAIL_PROVIDER=smtp
LOCAL_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=CREFANS <noreply@example.com>
# Host Postfix accepts loopback mail only. For remote SMTP, TLS is mandatory.
# SMTP_USER=
# SMTP_PASSWORD=
# Existing AWS/S3/MediaConvert/payment variables remain required for those features.
