[Unit]
Description=Send Crefans backup failure to existing operations channel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/local/lib/crefans-backup-alert/server_notify.py
TimeoutStartSec=75
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6
