# 비밀값 입력 후 Git에 커밋하지 않는다. 로컬은 .local/platform.env, 배포는 별도 비밀 runtime 파일 사용.
# 공급사 계약·정책 기준: docs/provider-contracts.md / infra/platform/README.md

# 실행 환경 — 기존 로컬 값 유지. 아래 주소는 실제 외부 테스트 환경에 맞춰 입력
# 격리 개발 DB 연결 주소. 운영 DB를 입력하지 않는다.
DATABASE_URL=mysql://crefans:CHANGE_ME@database:3306/crefans
# 신규 회원 인증 방식: local
AUTH_PROVIDER=local
# 로그인 서명·본인 식별 해시 키. 기존 값을 유지하고 별도 보관한다.
LOCAL_AUTH_SECRET=
# 빌링키 암호화용 32바이트 키(64자리 hex). 기존 값을 유지한다.
DATA_ENCRYPTION_KEY=
# API 수신 주소
HOST=0.0.0.0
# API 포트
PORT=3001
# 로컬 development / 운영 production
NODE_ENV=production
# 허용 프론트 출처. 복수 주소 구분 방식은 런타임 설정 문서 확인
FRONTEND_ORIGINS=https://YOUR_DOMAIN
# 운영 콘솔 출처. 설정하면 /api/v1/admin/*은 이 출처만, 나머지 API는 이 출처를 거부한다.
ADMIN_ORIGINS=https://admin.YOUR_DOMAIN
# PASS 서버 콜백용 외부 접근 가능한 HTTPS API 주소. /api/v1 경로를 제외한 origin
PUBLIC_API_ORIGIN=https://YOUR_DOMAIN
# 신규 미디어 저장 디렉터리. 로컬 기본값: .local/media
MEDIA_ROOT=/data/media

# 이메일 — 실제 인증메일 테스트 전 발송 계정 설정
# SMTP 사용 시 smtp 입력. 빈 값이면 이메일 발송 미설정
MEMBER_MAIL_PROVIDER=smtp
# SMTP 서버 호스트
SMTP_HOST=
# 공급사 지정 포트. 코드 기본값 587
SMTP_PORT=587
# 연결 시작부터 TLS 사용 여부: true / false. 공급사 포트 설정에 맞춘다.
SMTP_SECURE=false
# SMTP 로그인 계정. 인증 없는 로컬 릴레이일 때만 비워둔다.
SMTP_USER=
# SMTP 비밀번호 또는 공급사 발급 앱 비밀번호
SMTP_PASSWORD=
# 발송 가능한 인증된 발신 주소. 예: CREFANS <no-reply@example.com>
SMTP_FROM=

# 토스페이먼츠 — 동일 테스트 상점의 자동결제용 API 개별 연동 키 한 쌍
# 자동결제 테스트 클라이언트 키. 실제 서비스 UI는 서버에서 이 값을 전달받는다.
TOSS_CLIENT_KEY=
# 자동결제 테스트 시크릿 키. 프론트·채팅·Git에 노출하지 않는다.
TOSS_SECRET_KEY=

# 금융 정책 — 사업자가 결정할 값. 빈 값은 미결정이며 임의 기본 정책을 넣지 않는다
# 구형 미사용 환경 키: 수수료는 financial_policies.platform_fee_bps(DB, 0~10000 bps)에서 설정
PLATFORM_FEE_BPS=
# 구형 미사용 환경 키: 보류 기간은 financial_policies.settlement_hold_days(DB, 0~365)에서 설정
SETTLEMENT_HOLD_DAYS=
# 구형 설정(현재 미사용): 미이용 전액 환불은 기간 대신 서버 이용 기록으로 판정한다.
REFUND_WINDOW_DAYS=
# 정기결제 실패 후 재시도 횟수: 정수 0~10
RENEWAL_MAX_RETRIES=3
# 정기결제 재시도 간격(시간): 1~168
RENEWAL_RETRY_HOURS=24

# 가입 본인확인: 기본 pass. email-only는 PASS를 보류하며 성인인증 권한을 부여하지 않음.
# 별도의 시행 가능한 약관/개인정보 gate는 계속 적용됨. 공개 가입 전에 정책 준비 필요.
SIGNUP_IDENTITY_MODE=pass
# 초대 이메일을 쉼표로 구분. 비어 있으면 이메일 초대 제한 없음. 클라이언트에 명단 미노출.
SIGNUP_EMAIL_ALLOWLIST=

# PASS — 공식 공급사 연동 브리지 구현이 먼저 필요. 공급사 원본 키를 아래에 그대로 넣지 않는다
# 내부 PASS 연동 브리지 기본 URL
PASS_ADAPTER_URL=
# 브리지 요청 Bearer 인증 비밀값
PASS_ADAPTER_SECRET=
# 브리지와 공유하는 콜백 원문 HMAC-SHA256 검증 비밀값
PASS_CALLBACK_SECRET=

# 은행 — 공급사 테스트 브리지 구현 후 설정. 이체 실행은 별도로 활성화
# 내부 계좌 확인·이체 연동 브리지 기본 URL
BANK_ADAPTER_URL=
# 은행 브리지 요청 Bearer 인증 비밀값
BANK_ADAPTER_SECRET=
# true일 때 이체 요청 허용. 빈 값/false는 이체 비활성화. 테스트 준비 전 true 금지
BANK_PAYOUTS_ENABLED=false

# 미디어 정리 — 삭제 정책 확정 후 입력
# 미참조 파일 정리 유예 일수: 정수 7 이상
MEDIA_ORPHAN_GRACE_DAYS=
# true일 때 파일 삭제 허용. 빈 값/false는 삭제 비활성화
MEDIA_DELETE_ENABLED=false

# 신규 업로드: 로컬 개발은 local, 운영 비공개 S3는 s3.
# 모든 GET/HEAD/Range에서 세션·구독 검사 후 API가 스트리밍. 서명 URL 발급 금지.
# s3 설정 누락 시 시작 실패. EC2 임시 업로드 공간(MEDIA_ROOT)은 계속 필요하다.
MEDIA_STORAGE=local
S3_MEDIA_BUCKET=
# 32 random bytes encoded as 64 lowercase hex characters. Shared only with the private edge deployment.
# Authenticates edge authorization calls and signed viewer IPs; never put in frontend/public settings.
MEDIA_EDGE_SECRET=
# 신규/기존 S3 버킷 리전
AWS_REGION=
# 운영 EC2는 버킷 범위 IAM 역할 사용. 아래 장기 키를 설정하지 않는다.
AWS_ACCESS_KEY_ID=
# AWS 비밀키. 역할 인증 사용 시 키 쌍을 비워둘 수 있다.
AWS_SECRET_ACCESS_KEY=
# 기존 원본 미디어 버킷명
S3_UPLOAD_BUCKET=
# 기존 변환 미디어 버킷명
S3_PROCESSED_BUCKET=

# 운영 알림 전용: [crefans] operations 채널에 게시 권한이 있는 봇. NC 봇을 재사용하지 않는다.
TELEGRAM_OPERATIONS_BOT_TOKEN=
# 채널 numeric chat ID. 전송 전에 채널 제목/유형을 검증한다.
TELEGRAM_OPERATIONS_CHAT_ID=
# 직접 연결은 전달 헤더를 무시. Compose의 고정 Caddy IP만 신뢰한다.
# 로컬 API 직접 실행에서는 빈 값으로 사용한다.
TRUSTED_PROXY_IPS=172.30.90.2
# 알림에 표시할 환경명 (beta/production/local)
APP_ENV=

# Audit storage: member request records default to 7 days. Audit records and operator
# requests follow AUDIT_RETENTION_DAYS (0 = never delete). Values below 730 are refused:
# 개인정보의 안전성 확보조치 기준 제8조 requires 1~2 years for operator access records.
# 2026-10-29 owner decision: keep 2 years, then delete automatically.
ACCESS_LOG_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=730
# Set at build/deploy to correlate stack locations to the tested release.
APP_RELEASE=
# API-side watchdog: worker heartbeat, stuck payments/charges, alert backlog, log pruning lag.
OPERATIONS_WATCHDOG_ENABLED=true

# 2026-10-25 확정 베타: 초대 명단 없으면 가입 거부, Toss test_ck/test_sk만 허용, 실제 송금 금지.
BETA_MODE=true
# 광고 발송은 별도 승인 후 활성화. 동의·철회 처리결과/2년 확인도 같은 전달 큐를 사용.
MARKETING_MAIL_ENABLED=false
# HTTPS 서비스 origin. 광고 수신거부는 로그인 없는 서명 링크.
MARKETING_PUBLIC_ORIGIN=https://crefans.com
# 길이 32자 이상 별도 난수. 재설정하면 기존 수신거부 링크가 만료되므로 키 회전 계획 필요.
MARKETING_UNSUBSCRIBE_SECRET=

# 콩 원장 migration 적용 후 회원가입 지갑 생성을 활성화. 후원/충전/출금 API는 아직 연결하지 않음.
BEAN_LEDGER_ENABLED=false
# 운영키로 콩 충전 판매를 시작하기 전 PG의 충전/후원/환금성 업종 승인을 확인한 경우에만 true.
BEAN_LIVE_PAYMENTS_APPROVED=false

# Server-only mock persona verifier (salt:scrypt hex), empty disables preview login.
# Never prefix with NEXT_PUBLIC_ or use as real member authentication.
CREFANS_PREVIEW_LOGIN_HASH=
