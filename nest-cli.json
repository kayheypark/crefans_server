{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "platform/ai-photo-costumes/*.webp",
        "outDir": "dist/src"
      },
      {
        "include": "platform/ai-photo-backgrounds/*.webp",
        "outDir": "dist/src"
      },
      {
        "include": "platform/ai-photo-composite-bases/approved.json",
        "outDir": "dist/src"
      },
      {
        "include": "platform/ai-photo-composite-bases/*.webp",
        "outDir": "dist/src"
      }
    ]
  }
}
